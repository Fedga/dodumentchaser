# Version control
.git
.gitignore

# Environment variables and secrets (Strict protection - never bake credentials into image)
.env
.env.*
*.env
*.pem
*.key
*.cert
credentials*.json
service-account*.json
gcp-key*.json
client_secret*.json

# Dependencies and build output
node_modules
dist
dist-server

# Local test data and local file storage (prevent baking ephemeral data into production image)
data/
data/private_storage/

# Test suites and development verification scripts
tests/
scripts/

# Logs and cache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
bun.lock
